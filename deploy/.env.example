# One copy per environment on the VPS, never in git:
#   deploy/.env.production   (DEPLOY_ENV=production)
#   deploy/.env.staging      (DEPLOY_ENV=staging)
#
# Every secret below must be generated fresh for each environment. Nothing here may be
# copied from erp-backend/.env.example, which holds development values only.

# production | staging. Names the image, the Compose network alias and this file.
DEPLOY_ENV=production

# --- database --------------------------------------------------------------
# Hex, so it needs no escaping inside DATABASE_URL:
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# --- secrets ---------------------------------------------------------------
# The API refuses to start in production with the development JWT secret.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Signs short-lived file URLs and invitation QR codes. Separate from JWT_SECRET so either
# can be rotated alone. Same command as above; the API refuses to start without it.
SIGNING_SECRET=

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# --- api -------------------------------------------------------------------
# JSON list. The website, the ERP and the API share one origin (the site domain below), so
# nothing calls the API cross-origin; list the site's own origin anyway.
CORS_ORIGINS=["https://example.com"]
TIMEZONE=Asia/Jakarta
LOG_JSON=true
# Month-end depreciation, AR overdue sweep, CRM scans. On in production; usually off in
# staging so a restored copy of production does not post month-end twice.
SCHEDULER_ENABLED=true

# --- uploads ---------------------------------------------------------------
# Finance attachments. Invitation media has its own per-kind limits in the code.
MAX_UPLOAD_BYTES=10485760

# --- meeting minutes (AI) ---------------------------------------------------
# On when AI_PROVIDER and AI_API_KEY are both set. The key lives only here: it never reaches
# a browser and is never logged. deepseek | openai. Without a key, minutes are written by
# rules from the transcript and labelled as such.
AI_PROVIDER=deepseek
AI_API_KEY=
# Empty uses the provider's default model.
AI_MODEL=
# The spend cap: AI minutes per person per day. Over it, the free rule-based minutes are used.
AI_MINUTES_PER_DAY=10

# --- edge (production file only; Caddy serves both environments) ------------
# The ONE address for the website (/), the ERP (/erp/) and the API (/api/*). Not decided
# yet: put the real domain here before the first deploy, and point its DNS A record at the
# VPS first (Caddy requests the certificate on start).
SITE_DOMAIN=example.com
# Staging serves the same bundles against the staging API, on its own address.
STAGING_SITE_DOMAIN=staging.example.com
# Let's Encrypt account e-mail: expiry and problem notices go here.
ACME_EMAIL=

# --- backups (deploy/backup.sh) --------------------------------------------
# An rclone remote and path, e.g. r2:oscenia-backups/production. Configure the remote
# once with `rclone config`. Empty keeps backups on the VPS only, which is not a backup.
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
