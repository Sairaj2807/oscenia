# Copy to .env for local development. .env is gitignored.
ENV=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://oscenia:oscenia@localhost:5433/oscenia_erp
TEST_DATABASE_URL=postgresql+asyncpg://oscenia:oscenia@localhost:5433/oscenia_erp_test
DB_ECHO=false

# Generate for production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-key-change-me-in-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

STORAGE_DIR=./var/attachments
MAX_UPLOAD_BYTES=10485760

# Company operating timezone. Drives what "today" means for ageing and due dates.
TIMEZONE=Asia/Jakarta

# Meeting minutes (team chat). Leave AI_PROVIDER empty to use rule-based minutes only.
# AI_PROVIDER=deepseek        # or openai
# AI_API_KEY=
# AI_MODEL=                   # blank = the provider default (deepseek-chat / gpt-4o-mini)
# AI_MINUTES_PER_DAY=10       # per person; over it, rule-based minutes are written instead

# Google Calendar (optional; the Google screen says "not set up" until all four are present).
# OAuth client of type "web" from a Google Cloud project with the Calendar API on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
GOOGLE_RETURN_URL=http://localhost:5173/google-calendar
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=
