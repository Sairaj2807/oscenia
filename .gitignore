# Dependencies / build output
**/node_modules
**/dist
**/dist-ssr

# Python (erp-backend)
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
erp-backend/var/

# Logs
*.log
npm-debug.log*

# Env / secrets. Only the .example templates are committed.
*.local
.env
.env.*
!.env.example
deploy/secrets/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json

# Office temp lock files
~$*

# Vercel link (the site now deploys to a VPS; keep stray local links out)
.vercel

# Delivered brand pack: source material, not shipped. 383MB with one file
# over GitHub's 100MB limit. See website/brand-assets/README.md.
website/brand-assets/

# Client documents, decks, raw footage and scratch files at the workspace
# root. Kept on disk, never committed.
/*.pptx
/*.docx
/*.pdf
/*.zip
/*.mp4
/*.html
/test.js
/_stale-root-git-backup/
/_stale-erp-prototype-backup/

